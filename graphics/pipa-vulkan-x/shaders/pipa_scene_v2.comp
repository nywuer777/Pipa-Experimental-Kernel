#version 450
// EXP29.17: tileable moving source texture with no expanding clamped region.
// Shared Vulkan ABI with original and diagnostic scene sources.
layout(local_size_x=16,local_size_y=16,local_size_z=1) in;
layout(set=0,binding=0,rgba8) uniform writeonly image2D realImage;
layout(push_constant) uniform SceneParams {
    ivec2 dimensions;
    int frameIndex;
    int reserved;
} scene;

void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,scene.dimensions))) return;

    // Shift is bounded and wraps within source width. Unlike the EXP29.14
    // max(0, x - shift) path, the left portion never collapses to one texel.
    int shift=(scene.frameIndex*2)%scene.dimensions.x;
    int x=(p.x-shift+scene.dimensions.x)%scene.dimensions.x;
    int y=p.y;

    // Source width 1280 = ten repeatable 128px tiles. Geometry is deliberately
    // low-frequency so nearest-neighbor scaling/rotation cannot amplify
    // pseudo-random fine grain into banding.
    int localX=x%128;
    int localY=y%128;
    int tileIndex=((x/128)+(y/128))&1;
    vec3 rgb=tileIndex==0 ? vec3(0.15,0.23,0.31):vec3(0.20,0.29,0.36);
    float fx=float(localX-64)/64.0;
    float fy=float(localY-64)/64.0;
    float halo=1.0-smoothstep(0.18,0.9,length(vec2(fx,fy)));
    rgb+=vec3(0.06,0.055,0.04)*halo;
    if(localX<2 || localY<2)rgb=vec3(0.37,0.43,0.49);

    // Deliberate large moving contrast targets. Their motion is exactly
    // 2 pixels per input frame, matching the existing Motion search budget.
    if(x>=275 && x<295 && y>=150 && y<585)
        rgb=vec3(0.98,0.87,0.12);
    if(x>=540 && x<630 && y>=260 && y<340)
        rgb=vec3(0.10,0.91,0.96);
    if(x>=940 && x<1000 && y>=410 && y<485)
        rgb=vec3(0.90,0.22,0.52);
    imageStore(realImage,p,vec4(clamp(rgb,0.0,1.0),1.0));
}

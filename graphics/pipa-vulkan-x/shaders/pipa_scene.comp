#version 450
// EXP29.14: GPU-native evolving source scene. No screen capture or game injection.
// Two unique real inputs per pair, two pixels of motion per simulated input tick.
layout(local_size_x=16,local_size_y=16,local_size_z=1) in;
layout(set=0,binding=0,rgba8) uniform writeonly image2D realImage;
layout(push_constant) uniform SceneParams {
    ivec2 dimensions;
    int frameIndex;
    int reserved;
} scene;

void main() {
    ivec2 xy=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(xy,scene.dimensions))) return;
    int x=max(0,xy.x-2*scene.frameIndex),y=xy.y;
    int cell=((x/16+y/16)&1)==0?32:46;
    int grain=(x*17+y*23+(x*y)%29)&63;
    vec3 rgb=vec3(min(255,cell+grain*2),min(255,cell+grain),
                  min(255,cell+grain/2))/255.0;
    // High-contrast moving bars reveal whether unique inputs and synthesized
    // intermediate frames progress continuously. The patterned background
    // also moves to exercise the motion vector search.
    if(x>=275 && x<290 && y>=140 && y<575)
        rgb=vec3(1.0,0.86,0.09);
    if(x>=520 && x<565 && y>=245 && y<315)
        rgb=vec3(0.12,0.9,0.95);
    // Nonmoving HUD ID, useful for identifying rendering updates and
    // observing expected UI interpolation artifacts.
    if(xy.y<42 && xy.x>=25 && xy.x<25+16*20) {
        int bit=(xy.x-25)/20;
        if((scene.frameIndex&(1<<bit))!=0) rgb=vec3(0.18,0.85,0.25);
        else rgb=vec3(0.05,0.08,0.09);
    }
    imageStore(realImage,xy,vec4(rgb,1.0));
}

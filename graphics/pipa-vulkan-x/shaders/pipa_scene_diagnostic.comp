#version 450
// EXP29.16: independent diagnostic source shader, same descriptor/push ABI
// as pipa_scene.comp. Exact solid-color orientation and uniform geometry.
// No procedural noise, no bit-HUD, no wraparound image sampling.
layout(local_size_x=16,local_size_y=16,local_size_z=1) in;
layout(set=0,binding=0,rgba8) uniform writeonly image2D realImage;
layout(push_constant) uniform SceneParams {
    ivec2 dimensions;
    int frameIndex;
    int reserved;
} scene;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,scene.dimensions))) return;
    int halfW=scene.dimensions.x/2;
    int halfH=scene.dimensions.y/2;
    // Four deliberately different opaque quadrants: detect inversion/rotation.
    vec3 rgb=p.y<halfH
        ? (p.x<halfW ? vec3(0.12,0.19,0.38) : vec3(0.19,0.35,0.49))
        : (p.x<halfW ? vec3(0.29,0.27,0.17) : vec3(0.39,0.23,0.26));
    if((p.x%80)==0 || (p.y%80)==0) rgb=vec3(0.78,0.78,0.78);
    // Corner identity tags are in texture-coordinate space, not Android UI.
    if(p.x<70 && p.y<70) rgb=vec3(0.93,0.08,0.08); // top-left red
    if(p.x>=scene.dimensions.x-70 && p.y<70) rgb=vec3(0.08,0.88,0.15); // top-right green
    if(p.x<70 && p.y>=scene.dimensions.y-70) rgb=vec3(0.11,0.20,0.97); // bottom-left blue
    if(p.x>=scene.dimensions.x-70 && p.y>=scene.dimensions.y-70)
        rgb=vec3(0.96,0.91,0.12); // bottom-right yellow
    // Moving cyan rectangle with exactly +2px per real input frame.
    int x0=190+(scene.frameIndex%160)*2;
    if(p.x>=x0 && p.x<x0+96 && p.y>=280 && p.y<380)
        rgb=vec3(0.04,0.95,0.98);
    // Moving magenta vertical bar for unambiguous visual interpolation.
    int x1=840+(scene.frameIndex%110)*2;
    if(p.x>=x1 && p.x<x1+14 && p.y>=150 && p.y<610)
        rgb=vec3(0.98,0.12,0.70);
    imageStore(realImage,p,vec4(rgb,1.0));
}

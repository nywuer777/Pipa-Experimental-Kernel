# Adaptadores Ethernet USB (o Pad 6 não tem porta Ethernet; usa USB-C)
# Copie para $WORKDIR/ethernet.config. Símbolos que não existirem neste kernel são ignorados pelo olddefconfig.
CONFIG_MII=y
CONFIG_VLAN_8021Q=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y

# Genéricos / padrão USB
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_NET_RNDIS_HOST=y

# ASIX (100M e Gigabit)
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y

# Realtek (RTL8150 e RTL8152/8153, 100M e Gigabit)
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y

# Microchip / SMSC
CONFIG_USB_LAN78XX=y
CONFIG_USB_NET_SMSC75XX=y
CONFIG_USB_NET_SMSC95XX=y

# Aquantia / Marvell (multi-gigabit)
CONFIG_USB_NET_AQC111=y

# Davicom, Moschip, CoreChips e legados
CONFIG_USB_NET_DM9601=y
CONFIG_USB_NET_SR9700=y
CONFIG_USB_NET_MCS7830=y
CONFIG_USB_PEGASUS=y
CONFIG_USB_KAWETH=y
